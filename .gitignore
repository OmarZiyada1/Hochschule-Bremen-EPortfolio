# Lokale Umgebungsvariablen - enthalten Zugangsdaten, nie einchecken.
# Die Vorlage .env.example ist bewusst ausgenommen.
.env
.env.*
!.env.example

# Build-Artefakte
target/

# Ablage des Local-Speicheradapters (app.storage.local-directory, KAN-50).
# Enthaelt hochgeladene Dateien der Entwicklungsumgebung.
var/

# Arbeitskopie der Confluence-Contract-Seite (Skill api-contract-sync).
# Wird per contract.py neu gezogen, gehoert nicht in die Historie.
.contract-cache/

# IDE
.idea/
*.iml

# Arbeitskopien der Confluence-Kapitelseiten (Skill thesis-schreiben).
# Werden per contract.py neu gezogen, gehoeren nicht in die Historie.
.thesis-cache/

# Bytecode der Skill-Werkzeuge (contract.py, thesis.py).
__pycache__/

# Ausgefuellte Karten B1 der Usability-Testwoche (make_docs.py --passwort).
# Sie tragen das Testpasswort im Klartext, werden je Sitzung gedruckt und
# danach vernichtet. Sie gehoeren nicht in die Historie.
Testmaterial/_sitzung/
