# Lokale Umgebungsvariablen - enthalten Zugangsdaten, nie einchecken.
# Die Vorlage .env.example ist bewusst ausgenommen.
.env
.env.*
!.env.example

# Build-Artefakte
target/

# Ablage des Local-Speicheradapters (app.storage.local-directory, KAN-50).
# Enthaelt hochgeladene Dateien der Entwicklungsumgebung.
var/

# Arbeitskopie der Confluence-Contract-Seite (Skill api-contract-sync).
# Wird per contract.py neu gezogen, gehoert nicht in die Historie.
.contract-cache/

# IDE
.idea/
*.iml
