# Vorlage fuer die lokale .env - kopieren mit:
#   cp .env.example .env
# Die echte .env wird NICHT eingecheckt (siehe .gitignore).
#
# Aufbau: der erste Block wird zum Entwickeln gebraucht, der zweite nur im
# Profil prod. Zum Entwickeln ist kein Fremddienst noetig (API-Contract §6.8):
# Dateien liegen im Dateisystem, Mails stehen in der Serverkonsole.

# ==========================================================================
# Immer noetig (Profil dev und prod)
# ==========================================================================

# --- PostgreSQL ---
# Von docker-compose.yml (Container-Setup) und application.yml (JDBC) gelesen.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eportfolio
POSTGRES_USER=eportfolio
POSTGRES_PASSWORD=change-me

# --- Auth (KAN-5) ---
# Signaturschluessel fuer die JWTs. KEIN Default im Code - fehlt der Wert,
# startet die Anwendung nicht. Eigenen Wert erzeugen, z. B. mit:
#   openssl rand -base64 64
# Mindestens 64 Byte, weil mit HS512 signiert wird.
JWT_SECRET=change-me-openssl-rand-base64-64

# Erlaubte CORS-Origins (Komma-getrennt). Im Profil dev optional, dort greift
# der Vite-Dev-Server als Default; im Profil prod Pflicht.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Passwort der Dev-Testnutzer (Seeder, greift nur im Profil dev).
DEV_TEST_PASSWORD=change-me

# ==========================================================================
# Nur im Profil prod (KAN-50, API-Contract §6.8)
# ==========================================================================
# Zum Entwickeln leer lassen. Im Profil dev liest sie niemand: dort steht
# app.storage.provider auf "local" und app.mail.provider auf "log".
#
# Im Profil prod ist jeder dieser Werte Pflicht. Fehlt einer, startet die
# Anwendung nicht und nennt den fehlenden Schluessel. Das ist Absicht: eine
# Anwendung, die mit halber Konfiguration hochkommt und erst beim ersten
# Upload scheitert, verschiebt den Fehler an die teuerste Stelle.

# --- Objektspeicher: Azure Blob Storage (KAN-23) ---
# Name des Blob-Containers, in dem die hochgeladenen Dateien liegen.
AZURE_STORAGE_CONTAINER=

# Verbindungszeichenfolge des Speicherkontos. Enthaelt Endpoint, Kontoname und
# Kontoschluessel in einem Wert und ist damit ein Geheimnis: nie einchecken,
# nie in ein Ticket kopieren, nie ins Log schreiben. Zu finden im Azure-Portal
# unter Speicherkonto > Sicherheit + Netzwerk > Zugriffsschluessel.
# Form:
#   DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# --- Mailversand (KAN-51) ---
# Absenderadresse der Verifizierungs- und Ruecksetzmails (§3.1.1). Muss zur
# Domain des SMTP-Relays passen, sonst weist das Relay die Nachricht ab.
MAIL_FROM_ADDRESS=

# Oeffentliche Adresse des Frontends. Basis der Links in diesen Mails, deshalb
# ohne abschliessenden Schraegstrich.
APP_BASE_URL=

# Verbindung zum SMTP-Relay (spring.mail.*, gelesen vom Adapter aus KAN-51).
# Funktioniert gegen jedes Relay, das SMTP spricht: Gmail, Azure Communication
# Services, das Rechenzentrum der HSB. Port 587 ist der uebliche Wert fuer
# STARTTLS, das die Anwendung erzwingt.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=

# Passwort beziehungsweise Anwendungsschluessel des Relay-Kontos. Ein Geheimnis:
# nie einchecken, nie in ein Ticket kopieren, nie ins Log schreiben.
MAIL_PASSWORD=
