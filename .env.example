# Vorlage fuer die lokale .env - kopieren mit:
#   cp .env.example .env
# Die echte .env wird NICHT eingecheckt (siehe .gitignore).
#
# Aufbau: der erste Block wird zum Entwickeln gebraucht, der zweite nur im
# Profil prod. Zum Entwickeln ist kein Fremddienst noetig (API-Contract §6.8):
# Dateien liegen im Dateisystem, Mails stehen in der Serverkonsole.

# ==========================================================================
# Immer noetig (Profil dev und prod)
# ==========================================================================

# --- PostgreSQL ---
# Von docker-compose.yml (Container-Setup) und application.yml (JDBC) gelesen.
#
# POSTGRES_HOST bleibt localhost. Laeuft das Backend selbst im Container,
# setzt docker-compose.yml dort "db" und "5432" fuer den Container ein: im
# Compose-Netz gilt der Dienstname, nicht der auf dem Host veroeffentlichte
# Port. POSTGRES_PORT steuert genau diesen Host-Port; wer ihn wegen einer
# belegten 5432 aendert, aendert damit auch die JDBC-URL fuer den Start aus
# der IDE, aber nichts an der Verbindung zwischen den Containern.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eportfolio
POSTGRES_USER=eportfolio
POSTGRES_PASSWORD=change-me

# --- Auth (KAN-5) ---
# Signaturschluessel fuer die JWTs. KEIN Default im Code - fehlt der Wert,
# startet die Anwendung nicht. Eigenen Wert erzeugen, z. B. mit:
#   openssl rand -base64 64
# Mindestens 64 Byte, weil mit HS512 signiert wird.
JWT_SECRET=change-me-openssl-rand-base64-64

# Erlaubte CORS-Origins (Komma-getrennt). Im Profil dev optional, dort greift
# der Vite-Dev-Server als Default; im Profil prod Pflicht.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Passwort der Dev-Testnutzer (Seeder, greift nur im Profil dev).
DEV_TEST_PASSWORD=change-me

# --- Ports der Container ---
# Nur von den compose-Dateien gelesen, nicht von der Anwendung: das sind die
# Ports auf dem HOST. Im Compose-Netz sprechen die Container untereinander
# immer 8080 (Backend) und 80 beziehungsweise 5173 (Frontend).
#
# Die drei Betriebsarten liegen in getrennten Compose-Projekten und koennen
# nebeneinander laufen. Deshalb hat jede eigene Host-Ports; zwei Betriebsarten
# mit demselben Port waeren nicht gleichzeitig startbar.
#
# Der Datenbank-Port von DEV ist absichtlich POSTGRES_PORT von oben und hat
# keinen eigenen Namen: dieselbe Variable steht in der JDBC-URL von
# application-dev.yml. Wer das Backend aus der IDE gegen die DEV-Datenbank
# startet, trifft damit denselben Port.
DEV_BACKEND_PORT=8080
DEV_FRONTEND_PORT=5173

# Host-Port des Azurite-Blob-Emulators (nur Betriebsart DEV, KAN-23). Gegen
# ihn laeuft der Adaptertest AzureBlobFileStorageTest; wie bei der Datenbank
# setzt ./mvnw test voraus, dass die DEV-Betriebsart laeuft. Die Anwendung
# selbst benutzt Azurite nicht (app.storage.provider=local im Profil dev).
AZURITE_BLOB_PORT=10000

ARTIFACT_BACKEND_PORT=8180
ARTIFACT_FRONTEND_PORT=5273
ARTIFACT_POSTGRES_PORT=5433

PROD_BACKEND_PORT=8280
PROD_FRONTEND_PORT=5373
PROD_POSTGRES_PORT=5434

# Erlaubte Origins fuer ARTIFACT-DEV. Eigener Eintrag, weil diese Betriebsart
# auf einem anderen Port ausgeliefert wird als DEV und CORS_ALLOWED_ORIGINS
# von oben auf 5173 zeigt.
ARTIFACT_CORS_ALLOWED_ORIGINS=http://localhost:5273

# ==========================================================================
# Nur im Profil prod (KAN-50, API-Contract §6.8)
# ==========================================================================
# Zum Entwickeln leer lassen. Im Profil dev liest sie niemand: dort steht
# app.storage.provider auf "local" und app.mail.provider auf "log".
#
# Im Profil prod ist jeder dieser Werte Pflicht. Fehlt einer, startet die
# Anwendung nicht und nennt den fehlenden Schluessel. Das ist Absicht: eine
# Anwendung, die mit halber Konfiguration hochkommt und erst beim ersten
# Upload scheitert, verschiebt den Fehler an die teuerste Stelle.

# --- Objektspeicher: Azure Blob Storage (KAN-23) ---
# Name des Blob-Containers, in dem die hochgeladenen Dateien liegen.
AZURE_STORAGE_CONTAINER=

# Verbindungszeichenfolge des Speicherkontos. Enthaelt Endpoint, Kontoname und
# Kontoschluessel in einem Wert und ist damit ein Geheimnis: nie einchecken,
# nie in ein Ticket kopieren, nie ins Log schreiben. Zu finden im Azure-Portal
# unter Speicherkonto > Sicherheit + Netzwerk > Zugriffsschluessel.
# Form:
#   DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=

# --- Mailversand (KAN-51) ---
# Absenderadresse der Verifizierungs- und Ruecksetzmails (§3.1.1). Muss zur
# Domain des SMTP-Relays passen, sonst weist das Relay die Nachricht ab.
MAIL_FROM_ADDRESS=

# Oeffentliche Adresse des Frontends. Basis der Links in diesen Mails, deshalb
# ohne abschliessenden Schraegstrich.
APP_BASE_URL=

# Verbindung zum SMTP-Relay (spring.mail.*, gelesen vom Adapter aus KAN-51).
# Funktioniert gegen jedes Relay, das SMTP spricht: Gmail, Azure Communication
# Services, das Rechenzentrum der HSB. Port 587 ist der uebliche Wert fuer
# STARTTLS, das die Anwendung erzwingt.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=

# Passwort beziehungsweise Anwendungsschluessel des Relay-Kontos. Ein Geheimnis:
# nie einchecken, nie in ein Ticket kopieren, nie ins Log schreiben.
MAIL_PASSWORD=

# ==========================================================================
# Werkzeugkette: Atlassian (gehoert in eine eigene Datei .env.atlassian)
# ==========================================================================
#
# Diese drei Werte liest ausschliesslich das Werkzeug
# .claude/skills/api-contract-sync/contract.py, mit dem die Confluence-Seite
# „Datenmodell & API-Contract" (ID 36732929) gelesen und geschrieben wird.
# Die Anwendung selbst braucht sie nicht, deshalb stehen sie nicht in der .env,
# sondern in .env.atlassian (ebenfalls von .gitignore erfasst).
#
# API-Token erzeugen unter id.atlassian.com/manage-profile/security/api-tokens.
# Das Token gilt fuer Confluence und Jira gleichermassen und traegt die Rechte
# des Kontos: es kann Seiten ueberschreiben, also wie ein Passwort behandeln.
#
#   ATLASSIAN_BASE_URL=https://<instanz>.atlassian.net
#   ATLASSIAN_EMAIL=<konto>@<domain>
#   ATLASSIAN_API_TOKEN=<token>
